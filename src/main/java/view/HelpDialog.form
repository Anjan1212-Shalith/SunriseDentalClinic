      <SubComponents>
        <Component class="javax.swing.JTextPane" name="txtHelp">
          <Properties>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="contentType" type="java.lang.String" value="text/html"/>
            <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;body style=&apos;font-family:Segoe UI, sans-serif; font-size:12px; color:#1e293b; padding:10px;&apos;&gt;&lt;h2 style=&apos;color:#0f766e;&apos;&gt;Welcome to Sunrise Dental Clinic&lt;/h2&gt;&lt;p&gt;This computerized system streamlines patient records, appointment scheduling, billing, and distributed services.&lt;/p&gt;&lt;hr/&gt;&lt;h3 style=&apos;color:#0f766e;&apos;&gt;1. Authentication&lt;/h3&gt;&lt;p&gt;Enter username and password (admin / admin123 or receptionist / staff123).&lt;/p&gt;&lt;h3 style=&apos;color:#0f766e;&apos;&gt;2. Patients&lt;/h3&gt;&lt;p&gt;Add, edit, delete, and search patient details.&lt;/p&gt;&lt;h3 style=&apos;color:#0f766e;&apos;&gt;3. Appointments&lt;/h3&gt;&lt;p&gt;Select patient, doctor, treatment, date and time slot. Prevents double-booking automatically.&lt;/p&gt;&lt;h3 style=&apos;color:#0f766e;&apos;&gt;4. Billing&lt;/h3&gt;&lt;p&gt;Calculates treatment and consultation charges with discount and prints official receipts.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
